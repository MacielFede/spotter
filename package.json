{
  "name": "spotter",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "codegen": "pnpm --filter @spotter/codegen generate",
    "test:fixtures": "vitest run packages/domain/src/fixtures.test.ts apps/phone/src/lib/workout.test.ts",
    "build:phone": "pnpm --filter phone exec expo prebuild",
    "build:wearos": "cd apps/wearos && ./gradlew :app:assembleDebug"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
