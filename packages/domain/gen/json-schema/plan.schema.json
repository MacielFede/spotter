{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "name": {
      "type": "string"
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Routine"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "routines"
  ],
  "additionalProperties": false,
  "$defs": {
    "Routine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "name": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Module"
          }
        }
      },
      "required": [
        "id",
        "name",
        "active",
        "modules"
      ],
      "additionalProperties": false,
      "title": "Routine"
    },
    "Module": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ModuleKind"
        },
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "required": [
        "kind",
        "enabled",
        "items"
      ],
      "additionalProperties": false,
      "title": "Module"
    },
    "ModuleKind": {
      "type": "string",
      "enum": [
        "warmup",
        "stretching",
        "core",
        "cardio"
      ],
      "title": "ModuleKind"
    },
    "Item": {
      "oneOf": [
        {
          "$ref": "#/$defs/ExerciseItem"
        },
        {
          "$ref": "#/$defs/SupersetItem"
        }
      ],
      "title": "Item"
    },
    "ExerciseItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "exercise"
        },
        "exerciseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "sets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Set"
          }
        }
      },
      "required": [
        "kind",
        "exerciseId",
        "sets"
      ],
      "additionalProperties": false,
      "title": "ExerciseItem"
    },
    "Set": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "reps"
            },
            "targetReps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "weightKg": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "restSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "targetReps",
            "weightKg",
            "restSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "time"
            },
            "targetSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "weightKg": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "restSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "targetSeconds",
            "weightKg",
            "restSeconds"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Set"
    },
    "SupersetItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "superset"
        },
        "members": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupersetMember"
          }
        },
        "rounds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "restSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "members",
        "rounds",
        "restSeconds"
      ],
      "additionalProperties": false,
      "title": "SupersetItem"
    },
    "SupersetMember": {
      "type": "object",
      "properties": {
        "exerciseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "set": {
          "$ref": "#/$defs/SupersetMemberSet"
        }
      },
      "required": [
        "exerciseId",
        "set"
      ],
      "additionalProperties": false,
      "title": "SupersetMember"
    },
    "SupersetMemberSet": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "reps"
            },
            "targetReps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "weightKg": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "targetReps",
            "weightKg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "time"
            },
            "targetSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "weightKg": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "targetSeconds",
            "weightKg"
          ],
          "additionalProperties": false
        }
      ],
      "title": "SupersetMemberSet"
    }
  }
}
